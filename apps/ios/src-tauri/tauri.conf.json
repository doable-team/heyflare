{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "heyflare",
  "version": "0.3.0",
  "identifier": "team.doable.heyflare",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
