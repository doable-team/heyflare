{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "heyflare",
  "version": "0.3.0",
  "identifier": "team.doable.heyflare",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwRTNDQUQwRTg4MjczNzIKUldSeWM0TG8wTXJqTUE4YXBsenBGamhldGFnaVRvd2ZMR1ptajAvYzV5K2lKTFp4WWIzRXErWGUK",
      "endpoints": [
        "https://github.com/doable-team/heyflare/releases/latest/download/latest.json"
      ]
    }
  }
}